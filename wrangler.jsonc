{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cooperativas-habitacao-inquerito",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cooperativas-habitacao",
      // Substituir pelo ID devolvido pelo comando d1 create antes de publicar.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
